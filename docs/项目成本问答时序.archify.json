  "cards": [
    {
      "dot": "cyan",
      "title": "主链路",
      "items": [
        "路由命中 project-lifecycle-cost 多引擎剧本，注入契约",
        "先 batch_entity_source_mode 确认双源，再按引擎取数",
        "预算走 API 源（execute_entity_api），成本走 Doris（execute_doris_sql）"
      ]
    },
    {
      "dot": "rose",
      "title": "海关防线",
      "items": [
        "每次工具调用过契约站：白名单/引擎一致性/多引擎逐源确认",
        "模型试图继续检索被拒：两源取齐触发复合终止（stop_reached）",
        "禁 execute_sql 混用（多源查不到）——剧本铁律由海关执行"
      ]
    },
    {
      "dot": "violet",
      "title": "答案与回推",
      "items": [
        "两源结果由答案层按 wbs_element 关联，禁止 SQL 跨源 JOIN",
        "预算执行率/超支/超预算在答案内计算（actual_cost 对 total_budget）",
        "前端表格走 result_ref 全量派发，模型只看 10 行样本"
      ]
    }
  ]
