# tupu 基础设施栈连接信息（示例占位值）
#
# 用法：
#   1. 复制本文件为 .env.infra
#   2. 把所有 <change_me> 替换为真实密码
#   3. 真实的 .env.infra 不会入库（已被 .gitignore 排除）
#
# 启动：
#   docker compose --env-file .env.infra -f docker-compose.infra.yml up -d

# ============== Authentik (SSO/RBAC) ==============
AUTHENTIK_PG_USER=authentik
AUTHENTIK_PG_DB=authentik
AUTHENTIK_PG_PASSWORD=<change_me_pg_password>
AUTHENTIK_SECRET_KEY=<change_me_at_least_50_chars_long_random_string>
AUTHENTIK_PORT_HTTP=9100
AUTHENTIK_PORT_HTTPS=9143
AUTHENTIK_LOG_LEVEL=info
AUTHENTIK_BOOTSTRAP_PASSWORD=<change_me_admin_password>
AUTHENTIK_BOOTSTRAP_EMAIL=admin@tupu.local
AUTHENTIK_BOOTSTRAP_TOKEN=<change_me_32_chars_random_token>

# ============== Qdrant (向量库) ==============
QDRANT_PORT_REST=6333
QDRANT_PORT_GRPC=6334
QDRANT_API_KEY=<change_me_qdrant_api_key>

# ============== Neo4j (业务图) ==============
NEO4J_AUTH=neo4j/<change_me_neo4j_password>
NEO4J_PASSWORD=<change_me_neo4j_password>
NEO4J_PORT_HTTP=7474
NEO4J_PORT_BOLT=7687

# ============== tupu 业务 MySQL (主数据/配置库) ==============
TUPU_MYSQL_DB=tupu
TUPU_MYSQL_PASSWORD=<change_me_tupu_mysql_password>
TUPU_MYSQL_PORT=3306

# ============== tupu 业务 Elasticsearch (向量检索) ==============
TUPU_ES_PASSWORD=<change_me_tupu_es_password>
TUPU_ES_PORT=9200

# ============== tupu 业务 PostgreSQL (实体业务数据) ==============
TUPU_PG_USER=postgres
TUPU_PG_DB=tupu
TUPU_PG_PASSWORD=<change_me_tupu_pg_password>
TUPU_PG_PORT=5432
