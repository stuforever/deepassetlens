# 后端应用层环境变量配置示例
# 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会入库）
# 基础设施层密码（MySQL/PG/Neo4j/Qdrant/Authentik）见 .env.infra.example + docker-compose.infra.yml

# === 数据库 ===
# MySQL（tupu 主库，docker-compose.infra 启动的 docker-mysql-1）
DATABASE_URL=mysql+pymysql://root:root@localhost:33066/tupu?charset=utf8mb4

# === Neo4j 图数据库 ===
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# === Qdrant 向量库 ===
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_API_KEY=

# === Elasticsearch ===
ES_HOST=http://localhost:11200
ES_USER=elastic
ES_PASSWORD=

# === 大模型 API（按需配置，至少一个）===
# 智谱 GLM
GLM_API_KEY=
# DeepSeek
DEEPSEEK_API_KEY=
# 通义千问
DASHSCOPE_API_KEY=
# 豆包（火山引擎）
ARK_API_KEY=

# === 本地嵌入模型路径（可选，覆盖默认查找）===
# BGE_MODEL_PATH=/path/to/models/bge-large-zh-v1.5
# BGE_M3_MODEL_PATH=/path/to/models/bge-m3

# === 认证（可选）===
# ENABLE_AUTH=false
